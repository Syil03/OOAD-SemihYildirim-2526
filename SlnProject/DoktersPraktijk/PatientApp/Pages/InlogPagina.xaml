<Page x:Class="PatientApp.Pages.InlogPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Inloggen"
      Background="#F0F4F8">
    <Grid>
        <!-- Gecentreerde inlogkaart -->
        <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="White" CornerRadius="8" Padding="40,36,40,40">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15"/>
            </Border.Effect>
            <StackPanel>
                <!-- Titel -->
                <TextBlock Text="Dokterspraktijk" FontSize="26" FontWeight="Bold"
                           Foreground="#2E7D32" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Patiëntenportaal" FontSize="14" Foreground="#546E7A"
                           HorizontalAlignment="Center" Margin="0,0,0,36"/>

                <!-- E-mail -->
                <TextBlock Text="E-mailadres" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                <TextBox x:Name="TxtEmail" Height="40" Padding="10,0" FontSize="14"
                         BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"
                         KeyDown="Invoer_KeyDown"/>

                <!-- Wachtwoord -->
                <TextBlock Text="Wachtwoord" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                <PasswordBox x:Name="TxtPaswoord" Height="40" Padding="10,0" FontSize="14"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,28"
                             KeyDown="Invoer_KeyDown"/>

                <!-- Inlogknop -->
                <Button Content="Inloggen" Height="44" FontSize="15" FontWeight="SemiBold"
                        Background="#43A047" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnInloggen_Click"/>

                <!-- Foutmelding -->
                <TextBlock x:Name="TxtFout" Foreground="#D32F2F" FontSize="13"
                           TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
