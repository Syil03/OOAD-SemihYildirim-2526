<Page x:Class="PatientApp.Pages.AfspraakBoekenPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Afspraak Boeken"
      Background="#F0F4F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bovenbalk met naam van de patiënt en terugknop -->
        <Border Grid.Row="0" Background="#2E7D32" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtPatientNaam" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Nieuwe afspraak boeken" FontSize="13" Foreground="#C8E6C9"/>
                </StackPanel>

                <Button x:Name="BtnTerug" Grid.Column="1" Content="&#8592; Terug"
                        Padding="14,8" Cursor="Hand"
                        Background="#1B5E20" Foreground="White" BorderThickness="0"
                        Click="BtnTerug_Click"/>
            </Grid>
        </Border>

        <!-- Formulier (scrollbaar voor kleine schermen) -->
        <ScrollViewer Grid.Row="1" Margin="24,16,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640" HorizontalAlignment="Left">

                <!-- Sectie: Datum en tijdstip -->
                <Border Background="White" BorderBrush="#CFD8DC" BorderThickness="1"
                        CornerRadius="6" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Datum en tijdstip"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1B5E20" Margin="0,0,0,12"/>

                        <TextBlock Text="Kies een datum:"
                                   FontSize="13" Foreground="#546E7A" Margin="0,0,0,6"/>
                        <!-- DisplayDateStart wordt in de code-behind ingesteld op morgen -->
                        <Calendar x:Name="CalDatum" HorizontalAlignment="Left" Margin="0,0,0,16"/>

                        <TextBlock Text="Kies een tijdstip:"
                                   FontSize="13" Foreground="#546E7A" Margin="0,0,0,6"/>
                        <!-- Items worden dynamisch gevuld in de code-behind -->
                        <ComboBox x:Name="CmbTijdstip" Width="160" HorizontalAlignment="Left"
                                  Padding="8,6" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Sectie: Klacht / reden van bezoek -->
                <Border Background="White" BorderBrush="#CFD8DC" BorderThickness="1"
                        CornerRadius="6" Padding="20" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Reden van bezoek"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1B5E20" Margin="0,0,0,12"/>
                        <TextBlock Text="Beschrijf kort uw klacht of reden van bezoek:"
                                   FontSize="13" Foreground="#546E7A" Margin="0,0,0,6"/>
                        <TextBox x:Name="TxtKlacht" Height="90"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="8,6" FontSize="14" BorderBrush="#B0BEC5"/>
                    </StackPanel>
                </Border>

                <!-- Sectie: Dokter kiezen -->
                <Border Background="White" BorderBrush="#CFD8DC" BorderThickness="1"
                        CornerRadius="6" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="Kies een dokter"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="#1B5E20" Margin="0,0,0,12"/>
                        <TextBlock Text="Selecteer de gewenste arts:"
                                   FontSize="13" Foreground="#546E7A" Margin="0,0,0,6"/>
                        <!-- Items worden dynamisch geladen vanuit de databank -->
                        <ComboBox x:Name="CmbDokter" Width="320" HorizontalAlignment="Left"
                                  Padding="8,6" FontSize="14"/>
                    </StackPanel>
                </Border>

                <!-- Bevestigingsknop -->
                <Button x:Name="BtnBevestigen" Content="Afspraak bevestigen"
                        Padding="20,12" FontSize="15" FontWeight="SemiBold"
                        Background="#43A047" Foreground="White" BorderThickness="0"
                        Cursor="Hand" HorizontalAlignment="Left" Margin="0,0,0,24"
                        Click="BtnBevestigen_Click"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Fout- of succesmelding onderaan de pagina -->
        <TextBlock x:Name="TxtFout" Grid.Row="2"
                   FontSize="13" FontWeight="SemiBold"
                   Margin="24,8,24,16" TextWrapping="Wrap"
                   Visibility="Collapsed"/>
    </Grid>
</Page>
