<Page x:Class="PatientApp.Pages.ProfielPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mijn profiel"
      Background="#F0F4F8">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Groene sidebar met branding, naam en terug-knop -->
        <Border Grid.Column="0" Background="#2E7D32">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Branding en naam van de patiënt -->
                <StackPanel Grid.Row="0">
                    <TextBlock Text="Dokterspraktijk" FontSize="18" FontWeight="Bold"
                               Foreground="White" Margin="24,28,24,2"/>
                    <TextBlock Text="Patiëntenportaal" FontSize="12" Foreground="#C8E6C9"
                               Margin="24,0,24,28"/>

                    <Border Background="#1B5E20" Padding="24,16">
                        <StackPanel>
                            <TextBlock Text="INGELOGD ALS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#A5D6A7" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSidebarNaam" FontSize="15" FontWeight="Bold"
                                       Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Terug-knop onderaan de sidebar -->
                <Button Grid.Row="2" x:Name="BtnTerug" Content="← Terug naar afspraken"
                        Margin="20,0,20,24" Padding="12,10" Cursor="Hand"
                        Background="Transparent" Foreground="White"
                        BorderBrush="#A5D6A7" BorderThickness="1"
                        Click="BtnTerug_Click"/>
            </Grid>
        </Border>

        <!-- Hoofdgedeelte -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Donkere header -->
            <Border Grid.Row="0" Background="#2E7D32" Padding="28,20">
                <TextBlock Text="Mijn profiel" FontSize="20" FontWeight="Bold" Foreground="White"/>
            </Border>

            <!-- Profielkaart -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Width="540" Margin="0,28,0,28" VerticalAlignment="Top" HorizontalAlignment="Center"
                        Background="White" CornerRadius="8" Padding="32">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.12"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Profielfoto -->
                        <Border Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Center"
                                Background="#E8F5E9" Margin="0,0,0,10" ClipToBounds="True">
                            <Image x:Name="ImgProfielfoto" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="TxtGeenFoto" Text="Geen profielfoto beschikbaar"
                                   FontSize="12" Foreground="#90A4AE" HorizontalAlignment="Center"
                                   Margin="0,0,0,10" Visibility="Collapsed"/>

                        <!-- Naam -->
                        <TextBlock x:Name="TxtVolledigeNaam" FontSize="22" FontWeight="Bold"
                                   Foreground="#212121" HorizontalAlignment="Center" Margin="0,8,0,24"/>

                        <!-- Gegevens als nette rijen met label en waarde -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- E-mailadres -->
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="E-mailadres" FontSize="14"
                                       Foreground="#90A4AE" Margin="0,0,0,16"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtEmail" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,16"/>

                            <!-- Gsm-nummer -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Gsm-nummer" FontSize="14"
                                       Foreground="#90A4AE" Margin="0,0,0,16"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtGsm" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,16"/>

                            <!-- Geslacht -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Geslacht" FontSize="14"
                                       Foreground="#90A4AE" Margin="0,0,0,16"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtGeslacht" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,16"/>

                            <!-- Geboortedatum -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Geboortedatum" FontSize="14"
                                       Foreground="#90A4AE" Margin="0,0,0,16"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtGeboortedatum" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,16"/>

                            <!-- Notificaties -->
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Notificaties" FontSize="14"
                                       Foreground="#90A4AE"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtNotificaties" FontSize="14"
                                       FontWeight="SemiBold" Foreground="#37474F"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Foutmelding -->
            <TextBlock x:Name="TxtFout" Grid.Row="2" Foreground="#D32F2F" FontSize="13"
                       Margin="28,8,28,16" TextWrapping="Wrap" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Page>
