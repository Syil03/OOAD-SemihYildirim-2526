<Window x:Class="PatientApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dokterspraktijk – Patiëntenportaal"
        Height="680" Width="980"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Breedte is Auto zodat de sidebar geen ruimte inneemt als ze verborgen is -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =================== SIDEBAR =================== -->
        <!-- Standaard verborgen; wordt zichtbaar na het inloggen -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Width="220"
                Background="#2E7D32" Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Branding en patiëntnaam -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Margin="20,24,20,0">
                        <TextBlock Text="Dokterspraktijk" FontSize="18" FontWeight="Bold"
                                   Foreground="White"/>
                        <TextBlock Text="Patiëntenportaal" FontSize="12" Foreground="#C8E6C9"
                                   Margin="0,2,0,20"/>
                    </StackPanel>

                    <!-- Naam van de ingelogde patiënt -->
                    <Border Background="#1B5E20" Padding="20,14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="INGELOGD ALS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#A5D6A7" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtPatientNaam" FontSize="14" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Navigatieknoppen -->
                <StackPanel Grid.Row="1" Margin="10,0">
                    <Button x:Name="BtnAfspraken" Content="Afspraken"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,12" Margin="0,0,0,2" Cursor="Hand"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="14"
                            Click="BtnAfspraken_Click"/>
                    <Button x:Name="BtnProfiel" Content="Mijn Profiel"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Padding="16,12" Margin="0,0,0,2" Cursor="Hand"
                            Background="Transparent" Foreground="White"
                            BorderThickness="0" FontSize="14"
                            Click="BtnProfiel_Click"/>
                </StackPanel>

                <!-- Uitlogknop onderaan de sidebar -->
                <Button Grid.Row="2" x:Name="BtnUitloggen" Content="Uitloggen"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Margin="10,0,10,24" Padding="16,12"
                        Background="#1B5E20" Foreground="White"
                        BorderThickness="0" FontSize="14" Cursor="Hand"
                        Click="BtnUitloggen_Click"/>
            </Grid>
        </Border>

        <!-- =================== INHOUD =================== -->
        <Frame x:Name="frameInhoud" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
