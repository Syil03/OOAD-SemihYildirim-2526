<Page x:Class="DokterApp.Pages.PatientenPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Patiënten"
      Background="#F0F4F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Paginatitel -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="28,18">
            <TextBlock Text="Patiënten" FontSize="20" FontWeight="Bold" Foreground="#212121"/>
        </Border>

        <!-- Zoekbalk -->
        <Grid Grid.Row="1" Margin="28,18,28,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtZoeken" Grid.Column="0" Height="38" Padding="10,0"
                     FontSize="14" BorderBrush="#CFD8DC" BorderThickness="1"
                     VerticalContentAlignment="Center"
                     KeyDown="TxtZoeken_KeyDown"/>
            <Button x:Name="BtnZoeken" Grid.Column="1" Content="Zoeken"
                    Height="38" Padding="16,0" Margin="8,0,0,0"
                    Background="#1B2A4A" Foreground="White" BorderThickness="0"
                    Cursor="Hand" Click="BtnZoeken_Click"/>
            <Button x:Name="BtnAllePatient" Grid.Column="2" Content="Alle patiënten"
                    Height="38" Padding="16,0" Margin="8,0,0,0"
                    Background="#ECEFF1" Foreground="#546E7A" BorderThickness="0"
                    Cursor="Hand" Click="BtnAllePatient_Click"/>
        </Grid>

        <!-- Patiëntenkaarten (dynamisch gevuld via code-behind, SlnDemoItemsGrid-patroon) -->
        <ScrollViewer Grid.Row="2" Margin="28,0,28,0" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="PnlPatienten" Orientation="Horizontal"/>
        </ScrollViewer>

        <!-- Foutmelding -->
        <TextBlock x:Name="TxtFout" Grid.Row="3" Foreground="#D32F2F" FontSize="13"
                   Margin="28,8,28,16" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</Page>
