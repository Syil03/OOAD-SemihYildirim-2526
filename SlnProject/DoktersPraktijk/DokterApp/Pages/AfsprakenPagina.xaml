<Page x:Class="DokterApp.Pages.AfsprakenPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Afspraken"
      Background="#F0F4F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Bovenbalk met naam van de dokter -->
        <Border Grid.Row="0" Background="#1565C0" Padding="24,16">
            <StackPanel>
                <TextBlock x:Name="TxtDokterNaam" FontSize="20" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Uw afspraken" FontSize="13" Foreground="#BBDEFB"/>
            </StackPanel>
        </Border>

        <!-- Filterrij -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,16,24,0">
            <Button x:Name="BtnToekomstig" Content="Toekomstige afspraken"
                    Padding="14,8" Margin="0,0,8,0" Cursor="Hand"
                    Background="#1976D2" Foreground="White" BorderThickness="0"
                    Click="BtnToekomstig_Click"/>
            <Button x:Name="BtnAlle" Content="Alle afspraken"
                    Padding="14,8" Cursor="Hand"
                    Background="#ECEFF1" Foreground="#546E7A" BorderThickness="0"
                    Click="BtnAlle_Click"/>
        </StackPanel>

        <!-- Afspraken (dynamisch gegenereerde kaarten) -->
        <ScrollViewer Grid.Row="2" Margin="24,12,24,0" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PnlAfspraken"/>
        </ScrollViewer>

        <!-- Foutmelding -->
        <TextBlock x:Name="TxtFout" Grid.Row="3" Foreground="#D32F2F" FontSize="13"
                   Margin="24,8,24,16" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</Page>
