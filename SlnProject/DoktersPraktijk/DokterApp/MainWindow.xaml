<Window x:Class="DokterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dokterspraktijk – Artsenportaal"
        Height="700" Width="1040"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Stijl voor navigatieknoppen: transparante achtergrond met hover-effect -->
        <Style x:Key="NavKnopStijl" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#C5CFD6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <!-- Overschrijf de standaard Windows-knopchrome zodat de hover-kleur klopt -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Grens" Background="{TemplateBinding Background}"
                                CornerRadius="6" Margin="10,2" Padding="0,11">
                            <ContentPresenter HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grens" Property="Background" Value="#243657"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Sidebar neemt enkel breedte in als ze zichtbaar is -->
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- =================== SIDEBAR =================== -->
        <Border x:Name="SidebarBorder" Grid.Column="0" Width="240"
                Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#1B2A4A" Offset="0"/>
                    <GradientStop Color="#152238" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- Logo en appnaam -->
                    <RowDefinition Height="Auto"/>
                    <!-- Gebruikersprofiel -->
                    <RowDefinition Height="Auto"/>
                    <!-- Navigatieknoppen (vult resterende ruimte) -->
                    <RowDefinition Height="*"/>
                    <!-- Uitloggen onderaan -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ── Rij 0: logo en portaalnaam ── -->
                <StackPanel Grid.Row="0" Margin="22,26,22,0">
                    <!-- Cirkel met plusteken als medisch logo -->
                    <Grid Width="42" Height="42" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Ellipse Fill="#2A3F6B"/>
                        <TextBlock Text="+" FontSize="26" FontWeight="Bold" Foreground="#5B8DD9"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,-4,0,0"/>
                    </Grid>
                    <TextBlock Text="Dokterspraktijk" FontSize="17" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Artsenportaal" FontSize="12" Foreground="#7F90AE"
                               Margin="0,3,0,22" HorizontalAlignment="Center"/>
                    <!-- Dunne scheidingslijn onder branding -->
                    <Rectangle Height="1" Fill="#243657" Margin="0,0,0,0"/>
                </StackPanel>

                <!-- ── Rij 1: gebruikersprofiel ── -->
                <Border Grid.Row="1" Margin="0,0,0,4" Padding="22,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Initialen-avatar -->
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="21"
                                Background="#2A3F6B" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSidebarInitialen"
                                       FontSize="15" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Naam en label -->
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="INGELOGD ALS" FontSize="10" FontWeight="SemiBold"
                                       Foreground="#7F90AE" Margin="0,0,0,3"/>
                            <TextBlock x:Name="TxtDokterNaam" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dunne scheidingslijn boven navigatie -->
                <Rectangle Grid.Row="1" Height="1" Fill="#243657"
                           VerticalAlignment="Bottom" Margin="22,0"/>

                <!-- ── Rij 2: navigatieknoppen ── -->
                <StackPanel Grid.Row="2" Margin="0,10,0,0">

                    <!-- Afspraken -->
                    <Button x:Name="BtnAfspraken" Style="{StaticResource NavKnopStijl}"
                            Click="BtnAfspraken_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- Actieve indicator: dunne balk links -->
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="IndAfspraken" Fill="White"
                                       RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
                            <TextBlock Grid.Column="1" Text="Afspraken"
                                       FontSize="14" Foreground="White"
                                       VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                    </Button>

                    <!-- Patiënten -->
                    <Button x:Name="BtnPatienten" Style="{StaticResource NavKnopStijl}"
                            Click="BtnPatienten_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="IndPatienten" Fill="White"
                                       RadiusX="2" RadiusY="2" Visibility="Collapsed"/>
                            <TextBlock Grid.Column="1" Text="Patiënten"
                                       FontSize="14" Foreground="White"
                                       VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                    </Button>
                </StackPanel>

                <!-- Dunne scheidingslijn boven uitloggen -->
                <Rectangle Grid.Row="3" Height="1" Fill="#243657"
                           VerticalAlignment="Top" Margin="22,0"/>

                <!-- ── Rij 3: uitlogknop ── -->
                <Button Grid.Row="3" x:Name="BtnUitloggen"
                        Style="{StaticResource NavKnopStijl}"
                        Margin="0,4,0,20"
                        Click="BtnUitloggen_Click">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Uitloggen"
                                   FontSize="14" Foreground="#90A4AE"
                                   VerticalAlignment="Center" Margin="16,0,0,0"/>
                    </Grid>
                </Button>
            </Grid>
        </Border>

        <!-- =================== INHOUD =================== -->
        <Frame x:Name="frameInhoud" Grid.Column="1" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
