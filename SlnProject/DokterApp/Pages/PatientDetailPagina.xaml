<Page x:Class="DokterApp.Pages.PatientDetailPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Patiëntdetails"
      Background="#F0F4F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Titelbalk met terugknop -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="20,14">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="← Terug" Click="BtnTerug_Click"
                        Background="Transparent" Foreground="#1B2A4A"
                        BorderBrush="#1B2A4A" BorderThickness="1"
                        Padding="10,5" Cursor="Hand" Margin="0,0,20,0"/>
                <TextBlock x:Name="TxtPaginaTitel" Text="Patiëntdetails" FontSize="20"
                           FontWeight="Bold" Foreground="#212121" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ===== LEESWEERGAVE ===== -->
        <ScrollViewer Grid.Row="1" x:Name="PnlLeesWeergave" VerticalScrollBarVisibility="Auto">
            <Border Width="540" Margin="0,28,0,28" VerticalAlignment="Top"
                    HorizontalAlignment="Center" Background="White"
                    CornerRadius="8" Padding="32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Profielfoto of initialen-placeholder -->
                    <Grid Width="120" Height="120" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Image x:Name="ImgProfielfoto" Width="120" Height="120"
                               Stretch="UniformToFill" Visibility="Collapsed"/>
                        <Grid x:Name="PnlInitialen">
                            <Ellipse Width="120" Height="120" Fill="#B0BEC5"/>
                            <TextBlock x:Name="TxtInitialen" FontSize="40" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>

                    <!-- Volledige naam als koptitel -->
                    <TextBlock x:Name="TxtVolledigeNaam" FontSize="22" FontWeight="Bold"
                               Foreground="#212121" HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Gegevens in een label-waarde-raster -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Geslacht"
                                   FontSize="14" Foreground="#90A4AE" Margin="0,0,0,14"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtGeslacht"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#37474F"
                                   Margin="0,0,0,14"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Geboortedatum"
                                   FontSize="14" Foreground="#90A4AE" Margin="0,0,0,14"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtGeboortedatum"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#37474F"
                                   Margin="0,0,0,14"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="E-mailadres"
                                   FontSize="14" Foreground="#90A4AE" Margin="0,0,0,14"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtEmail"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#37474F"
                                   Margin="0,0,0,14"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Gsm-nummer"
                                   FontSize="14" Foreground="#90A4AE" Margin="0,0,0,14"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtGsm"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#37474F"
                                   Margin="0,0,0,14"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Notificaties"
                                   FontSize="14" Foreground="#90A4AE" Margin="0,0,0,14"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtNotificaties"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#37474F"
                                   Margin="0,0,0,14"/>

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Patiënt-ID"
                                   FontSize="14" Foreground="#90A4AE"/>
                        <TextBlock Grid.Row="5" Grid.Column="1" x:Name="TxtPatientId"
                                   FontSize="14" FontWeight="SemiBold" Foreground="#37474F"/>
                    </Grid>

                    <!-- Knop om de bewerkweergave te openen -->
                    <Button x:Name="BtnBewerken" Content="Gegevens bewerken"
                            Padding="16,10" Margin="0,24,0,0"
                            Background="#1B2A4A" Foreground="White" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Left"
                            Click="BtnBewerken_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- ===== BEWERKWEERGAVE (standaard verborgen) ===== -->
        <ScrollViewer Grid.Row="1" x:Name="PnlBewerkWeergave"
                      Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <Border Width="540" Margin="0,28,0,28" VerticalAlignment="Top"
                    HorizontalAlignment="Center" Background="White"
                    CornerRadius="8" Padding="32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock x:Name="TxtBewerkTitel" Text="Gegevens bewerken" FontSize="20"
                               FontWeight="Bold" Foreground="#212121" Margin="0,0,0,24"/>

                    <!-- Voornaam -->
                    <TextBlock Text="Voornaam" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBewerkVoornaam" Height="40" Padding="10,0" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"/>

                    <!-- Achternaam -->
                    <TextBlock Text="Achternaam" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBewerkAchternaam" Height="40" Padding="10,0" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"/>

                    <!-- E-mailadres -->
                    <TextBlock Text="E-mailadres" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBewerkEmail" Height="40" Padding="10,0" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"/>

                    <!-- Wachtwoord: alleen zichtbaar bij aanmaken van een nieuwe patiënt -->
                    <TextBlock x:Name="LblWachtwoord" Text="Wachtwoord" FontSize="13"
                               Foreground="#37474F" Margin="0,0,0,4" Visibility="Collapsed"/>
                    <PasswordBox x:Name="TxtBewerkWachtwoord" Height="40" Padding="10,11"
                                 FontSize="14" BorderBrush="#CFD8DC" BorderThickness="1"
                                 Margin="0,0,0,16" Visibility="Collapsed"/>

                    <!-- Gsm-nummer -->
                    <TextBlock Text="Gsm-nummer (max. 10 tekens)" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBewerkGsm" Height="40" Padding="10,0" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"/>

                    <!-- Geslacht: index 0=Man, 1=Vrouw -->
                    <TextBlock Text="Geslacht" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbBewerkGeslacht" Width="200" HorizontalAlignment="Left"
                              Padding="8,6" FontSize="14" Margin="0,0,0,16">
                        <ComboBoxItem Content="Man"/>
                        <ComboBoxItem Content="Vrouw"/>
                    </ComboBox>

                    <!-- Geboortedatum in dd/MM/yyyy-formaat -->
                    <TextBlock Text="Geboortedatum (dd/MM/yyyy)" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBewerkGeboortedatum" Height="40" Padding="10,0" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"/>

                    <!-- Notificaties: index 0-3 stemt overeen met de Notificatie-enum -->
                    <TextBlock Text="Notificaties" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbBewerkNotificaties" Width="240" HorizontalAlignment="Left"
                              Padding="8,6" FontSize="14" Margin="0,0,0,24">
                        <ComboBoxItem Content="Geen notificaties"/>
                        <ComboBoxItem Content="Via e-mail"/>
                        <ComboBoxItem Content="Via sms"/>
                        <ComboBoxItem Content="Via e-mail en sms"/>
                    </ComboBox>

                    <!-- Foutmelding bij validatiefouten in het bewerkformulier -->
                    <TextBlock x:Name="TxtFoutBewerken" Foreground="#D32F2F" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,16" Visibility="Collapsed"/>

                    <!-- Actieknoppen -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnOpslaan" Content="Opslaan"
                                Padding="20,10" Margin="0,0,12,0"
                                Background="#1B2A4A" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="BtnOpslaan_Click"/>
                        <Button x:Name="BtnAnnuleren" Content="Annuleren"
                                Padding="20,10"
                                Background="#ECEFF1" Foreground="#546E7A" BorderThickness="0"
                                Cursor="Hand" Click="BtnAnnuleren_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Algemene foutmelding -->
        <TextBlock x:Name="TxtFout" Grid.Row="2" Foreground="#D32F2F" FontSize="13"
                   Margin="28,8,28,16" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</Page>
