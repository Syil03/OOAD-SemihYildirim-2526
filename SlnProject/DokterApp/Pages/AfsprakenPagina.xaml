<Page x:Class="DokterApp.Pages.AfsprakenPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Afspraken"
      Background="#F0F4F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Paginatitel -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="28,18">
            <TextBlock Text="Mijn afspraken" FontSize="20" FontWeight="Bold" Foreground="#212121"/>
        </Border>

        <!-- Hoofdinhoud: kalender links, profielfoto rechts -->
        <Grid Grid.Row="1" Margin="28,20,28,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== LINKER PANEEL ===== -->
            <StackPanel Grid.Column="0">

                <!-- Kalenderwidget waarmee de datum wordt geselecteerd -->
                <Calendar x:Name="Kalender"
                          SelectionMode="SingleDate"
                          SelectedDatesChanged="Kalender_SelectedDatesChanged"
                          Margin="0,0,0,14"/>

                <!-- Geselecteerde datum in leesbaar formaat -->
                <TextBlock x:Name="TxtGeselecteerdeDatum"
                           FontSize="14" FontWeight="SemiBold" Foreground="#1B2A4A"
                           Margin="0,0,0,10"/>

                <!-- Melding wanneer er geen afspraken zijn op de geselecteerde dag -->
                <TextBlock x:Name="TxtGeenAfspraken"
                           Text="Geen afspraken op deze dag."
                           FontSize="13" Foreground="#90A4AE"
                           Margin="0,0,0,10" Visibility="Collapsed"/>

                <!-- Lijst van afspraken: elk item toont patiëntnaam, tijdstip en klacht -->
                <ListBox x:Name="LstAfspraken"
                         MaxHeight="340"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Visibility="Collapsed"
                         SelectionChanged="LstAfspraken_SelectionChanged"
                         Margin="0,0,0,12"/>

                <!-- Detailpaneel: zichtbaar bij selectie van een toekomstige afspraak -->
                <Border x:Name="PnlDetail"
                        Visibility="Collapsed"
                        Background="White" CornerRadius="6" Padding="16,12"
                        BorderBrush="#DCE1E6" BorderThickness="1">
                    <!-- Knop is uitgeschakeld voor afspraken in het verleden -->
                    <Button x:Name="BtnAnnuleren" Content="Afspraak annuleren"
                            Padding="14,8" Background="#D32F2F" Foreground="White"
                            BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Left"
                            Click="BtnAnnuleren_Click"/>
                </Border>
            </StackPanel>

            <!-- ===== RECHTER PANEEL: profielfoto van de ingelogde dokter ===== -->
            <StackPanel Grid.Column="1" HorizontalAlignment="Center"
                        VerticalAlignment="Top" Margin="48,0,0,0">

                <TextBlock Text="INGELOGDE ARTS" FontSize="10" FontWeight="SemiBold"
                           Foreground="#7F90AE" HorizontalAlignment="Center"
                           Margin="0,0,0,12"/>

                <!-- Container voor foto of initialen-placeholder (beide overlappend in een Grid) -->
                <Grid Width="120" Height="120" HorizontalAlignment="Center"
                      Margin="0,0,0,14">
                    <!-- Echte profielfoto; wordt rondgeknipt via code-behind -->
                    <Image x:Name="ImgProfielfoto" Width="120" Height="120"
                           Stretch="UniformToFill" Visibility="Collapsed"/>
                    <!-- Grijze cirkel met initialen als er geen foto is -->
                    <Grid x:Name="PnlFotoPlaceholder">
                        <Ellipse Width="120" Height="120" Fill="#B0BEC5"/>
                        <TextBlock x:Name="TxtInitialen" FontSize="36" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- Naam van de ingelogde dokter -->
                <TextBlock x:Name="TxtDokterNaamFoto" FontSize="15" FontWeight="SemiBold"
                           Foreground="#1B2A4A" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="200"/>
            </StackPanel>
        </Grid>

        <!-- Foutmelding -->
        <TextBlock x:Name="TxtFout" Grid.Row="2" Foreground="#D32F2F" FontSize="13"
                   Margin="28,0,28,12" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</Page>
