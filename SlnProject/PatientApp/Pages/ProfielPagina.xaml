<Page x:Class="PatientApp.Pages.ProfielPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Mijn profiel"
      Background="#F0F4F8">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Paginatitel -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0"
                BorderThickness="0,0,0,1" Padding="28,18">
            <TextBlock Text="Mijn profiel" FontSize="20" FontWeight="Bold" Foreground="#212121"/>
        </Border>

        <!-- Profielkaart: leesweergave -->
        <ScrollViewer Grid.Row="1" x:Name="PnlLeesWeergave" VerticalScrollBarVisibility="Auto">
            <Border Width="540" Margin="0,28,0,28" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Background="White" CornerRadius="8" Padding="32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Profielfoto -->
                    <Border Width="120" Height="120" CornerRadius="60" HorizontalAlignment="Center"
                            Background="#E8F5E9" Margin="0,0,0,10" ClipToBounds="True">
                        <Image x:Name="ImgProfielfoto" Stretch="UniformToFill"/>
                    </Border>
                    <TextBlock x:Name="TxtGeenFoto" Text="Geen profielfoto beschikbaar"
                               FontSize="12" Foreground="#90A4AE" HorizontalAlignment="Center"
                               Margin="0,0,0,10" Visibility="Collapsed"/>

                    <!-- Naam -->
                    <TextBlock x:Name="TxtVolledigeNaam" FontSize="22" FontWeight="Bold"
                               Foreground="#212121" HorizontalAlignment="Center" Margin="0,8,0,24"/>

                    <!-- Gegevens als nette rijen met label en waarde -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- E-mailadres -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="E-mailadres" FontSize="14"
                                   Foreground="#90A4AE" Margin="0,0,0,16"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtEmail" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <!-- Gsm-nummer -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Gsm-nummer" FontSize="14"
                                   Foreground="#90A4AE" Margin="0,0,0,16"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtGsm" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <!-- Geslacht -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Geslacht" FontSize="14"
                                   Foreground="#90A4AE" Margin="0,0,0,16"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtGeslacht" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <!-- Geboortedatum -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Geboortedatum" FontSize="14"
                                   Foreground="#90A4AE" Margin="0,0,0,16"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtGeboortedatum" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#37474F" Margin="0,0,0,16"/>

                        <!-- Notificaties -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Notificaties" FontSize="14"
                                   Foreground="#90A4AE"/>
                        <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtNotificaties" FontSize="14"
                                   FontWeight="SemiBold" Foreground="#37474F"/>
                    </Grid>

                    <!-- Knop om de bewerkweergave te openen -->
                    <Button x:Name="BtnBewerken" Content="Profiel bewerken"
                            Padding="16,10" Margin="0,24,0,0"
                            Background="#2E7D32" Foreground="White" BorderThickness="0"
                            Cursor="Hand" HorizontalAlignment="Left"
                            Click="BtnBewerken_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Bewerkweergave: formulier om profielgegevens aan te passen (standaard verborgen) -->
        <ScrollViewer Grid.Row="1" x:Name="PnlBewerkWeergave"
                      Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <Border Width="540" Margin="0,28,0,28" VerticalAlignment="Top" HorizontalAlignment="Center"
                    Background="White" CornerRadius="8" Padding="32">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Profiel bewerken" FontSize="20" FontWeight="Bold"
                               Foreground="#212121" Margin="0,0,0,24"/>

                    <!-- Voornaam -->
                    <TextBlock Text="Voornaam" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBewerkVoornaam" Height="40" Padding="10,0" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"/>

                    <!-- Achternaam -->
                    <TextBlock Text="Achternaam" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBewerkAchternaam" Height="40" Padding="10,0" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"/>

                    <!-- E-mailadres -->
                    <TextBlock Text="E-mailadres" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBewerkEmail" Height="40" Padding="10,0" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"/>

                    <!-- Gsm-nummer -->
                    <TextBlock Text="Gsm-nummer (max. 10 tekens)" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBewerkGsm" Height="40" Padding="10,0" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"/>

                    <!-- Geslacht: index 0=Onbekend, 1=Man, 2=Vrouw -->
                    <TextBlock Text="Geslacht" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbBewerkGeslacht" Width="200" HorizontalAlignment="Left"
                              Padding="8,6" FontSize="14" Margin="0,0,0,16">
                        <ComboBoxItem Content="Onbekend"/>
                        <ComboBoxItem Content="Man"/>
                        <ComboBoxItem Content="Vrouw"/>
                    </ComboBox>

                    <!-- Geboortedatum als vrije tekst in dd/MM/yyyy-formaat -->
                    <TextBlock Text="Geboortedatum (dd/MM/yyyy)" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtBewerkGeboortedatum" Height="40" Padding="10,0" FontSize="14"
                             VerticalContentAlignment="Center"
                             BorderBrush="#CFD8DC" BorderThickness="1" Margin="0,0,0,16"/>

                    <!-- Notificaties: index 0-3 stemt overeen met de Notificatie-enum -->
                    <TextBlock Text="Notificaties" FontSize="13" Foreground="#37474F" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbBewerkNotificaties" Width="240" HorizontalAlignment="Left"
                              Padding="8,6" FontSize="14" Margin="0,0,0,24">
                        <ComboBoxItem Content="Geen notificaties"/>
                        <ComboBoxItem Content="Via e-mail"/>
                        <ComboBoxItem Content="Via sms"/>
                        <ComboBoxItem Content="Via e-mail en sms"/>
                    </ComboBox>

                    <!-- Foutmelding bij validatiefouten -->
                    <TextBlock x:Name="TxtFoutBewerken" Foreground="#D32F2F" FontSize="13"
                               TextWrapping="Wrap" Margin="0,0,0,16" Visibility="Collapsed"/>

                    <!-- Actieknoppen -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnOpslaan" Content="Opslaan"
                                Padding="20,10" Margin="0,0,12,0"
                                Background="#2E7D32" Foreground="White" BorderThickness="0"
                                Cursor="Hand" Click="BtnOpslaan_Click"/>
                        <Button x:Name="BtnAnnuleren" Content="Annuleren"
                                Padding="20,10"
                                Background="#ECEFF1" Foreground="#546E7A" BorderThickness="0"
                                Cursor="Hand" Click="BtnAnnuleren_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Foutmelding -->
        <TextBlock x:Name="TxtFout" Grid.Row="2" Foreground="#D32F2F" FontSize="13"
                   Margin="28,8,28,16" TextWrapping="Wrap" Visibility="Collapsed"/>
    </Grid>
</Page>
