<Page x:Class="PatientApp.Pages.InlogPagina"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Inloggen">
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Branding links -->
            <ColumnDefinition Width="2*"/>
            <!-- Formulier rechts -->
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== LINKS: donkergroen brandingpaneel ===== -->
        <Grid Grid.Column="0">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#1B5E20" Offset="0"/>
                    <GradientStop Color="#0D3B14" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <StackPanel VerticalAlignment="Center" Margin="52,0,40,0">
                <!-- Decoratief kruissymbool als medisch logo -->
                <Grid Width="52" Height="52" HorizontalAlignment="Left" Margin="0,0,0,28">
                    <Ellipse Fill="#2D6A31"/>
                    <TextBlock Text="+" FontSize="30" FontWeight="Bold" Foreground="#66BB6A"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Praktijknaam -->
                <TextBlock Text="Dokterspraktijk" FontSize="30" FontWeight="Bold"
                           Foreground="White" TextWrapping="Wrap"/>

                <!-- Portaalnaam -->
                <TextBlock Text="Patiëntenportaal" FontSize="14" Foreground="#80A882"
                           Margin="0,6,0,0" FontWeight="SemiBold"/>

                <!-- Scheidingslijn -->
                <Rectangle Height="2" Fill="#2D6A31" HorizontalAlignment="Left"
                           Width="48" Margin="0,22,0,22"/>

                <!-- Korte beschrijving -->
                <TextBlock Text="Bekijk uw afspraken en beheer uw profiel op één centrale plek."
                           FontSize="13" Foreground="#A5C8A7"
                           TextWrapping="Wrap" LineHeight="22"/>
            </StackPanel>
        </Grid>

        <!-- ===== RECHTS: inlogformulier ===== -->
        <Grid Grid.Column="1" Background="#F0F4F8">
            <Border Width="390" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="White" CornerRadius="10" Padding="44,42,44,44">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="2" Opacity="0.10" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Titel -->
                    <TextBlock Text="Inloggen" FontSize="26" FontWeight="Bold"
                               Foreground="#1B5E20" Margin="0,0,0,4"/>
                    <TextBlock Text="Voer uw gegevens in om verder te gaan"
                               FontSize="13" Foreground="#90A4AE" Margin="0,0,0,32"/>

                    <!-- E-mailadres label + invoerveld -->
                    <TextBlock Text="E-MAILADRES" FontSize="11" FontWeight="SemiBold"
                               Foreground="#546E7A" Margin="0,0,0,7"/>
                    <!-- Border als nette omlijsting met afgeronde hoeken -->
                    <Border BorderBrush="#C8E6C9" BorderThickness="1.5" CornerRadius="6"
                            Margin="0,0,0,20">
                        <TextBox x:Name="TxtEmail" Height="44" Padding="14,0" FontSize="14"
                                 VerticalContentAlignment="Center"
                                 BorderThickness="0" Background="Transparent"
                                 KeyDown="Invoer_KeyDown"/>
                    </Border>

                    <!-- Wachtwoord label + invoerveld met oogknop -->
                    <TextBlock Text="WACHTWOORD" FontSize="11" FontWeight="SemiBold"
                               Foreground="#546E7A" Margin="0,0,0,7"/>
                    <Border BorderBrush="#C8E6C9" BorderThickness="1.5" CornerRadius="6"
                            Margin="0,0,0,32">
                        <Grid Height="44">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <!-- Vaste breedte voor de oogknop -->
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>

                            <!-- PasswordBox: standaard zichtbaar, tekens verborgen -->
                            <PasswordBox x:Name="TxtPaswoord" Grid.Column="0"
                                         Padding="14,11" FontSize="14"
                                         BorderThickness="0" Background="Transparent"
                                         KeyDown="Invoer_KeyDown"/>

                            <!-- TextBox: over de PasswordBox heen, standaard verborgen;
                                 wordt zichtbaar wanneer de oogknop ingedrukt is -->
                            <TextBox x:Name="TxtPaswooordZichtbaar" Grid.Column="0"
                                     Padding="14,0" FontSize="14"
                                     BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center"
                                     Visibility="Collapsed"
                                     KeyDown="Invoer_KeyDown"/>

                            <!-- Oogknop: wisselt tussen PasswordBox en TextBox -->
                            <Button x:Name="BtnOogje" Grid.Column="1"
                                    Content="👁" FontSize="15"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#90A4AE" Cursor="Hand"
                                    Click="BtnOogje_Click"/>
                        </Grid>
                    </Border>

                    <!-- Inlogknop in de kleur van het brandingpaneel -->
                    <Button Content="Inloggen" Height="48" FontSize="15" FontWeight="SemiBold"
                            Background="#2E7D32" Foreground="White" BorderThickness="0"
                            Cursor="Hand" Click="BtnInloggen_Click"/>

                    <!-- Foutmelding -->
                    <TextBlock x:Name="TxtFout" Foreground="#D32F2F" FontSize="13"
                               TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
