<Window x:Class="WpfHelpdesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Helpdesk Systeem - Odisee" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Helpdesk Tickets Beheer"
                   FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <ListBox Grid.Row="1" Name="LstTickets" Margin="0,0,0,10"
                 FontFamily="Consolas" FontSize="12"/>

        <GroupBox Grid.Row="2" Header="Ticket Beheer" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Grid.Row="0" Grid.Column="0" Content="Beschrijving:"
                       Margin="0,5,5,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="0" Grid.Column="1" Name="TxtBeschrijving"
                         Margin="0,5,0,5" Padding="3"/>

                <Label Grid.Row="1" Grid.Column="0" Content="Indiener:"
                       Margin="0,5,5,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Name="TxtIndiener"
                         Margin="0,5,0,5" Padding="3"/>

                <Label Grid.Row="2" Grid.Column="0" Content="Type:"
                       Margin="0,5,5,5" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" Name="CbxType"
                          Margin="0,5,0,5"
                          SelectionChanged="CbxType_SelectionChanged"/>

                <Label Grid.Row="3" Grid.Column="0" Name="LblExtraInfo" Content="Toestel:"
                       Margin="0,5,5,5" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Name="TxtExtraInfo"
                         Margin="0,5,0,5" Padding="3"/>

                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,5">
                    <Button Name="BtnToevoegen" Content="Ticket Toevoegen"
                            Margin="0,0,10,0" Padding="15,5"
                            Click="BtnToevoegen_Click"/>
                    <Button Name="BtnAfsluiten" Content="Geselecteerd Ticket Afsluiten"
                            Padding="15,5"
                            Click="BtnAfsluiten_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
